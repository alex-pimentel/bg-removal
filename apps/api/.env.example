# Redis (task state only — results are stored in R2)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_QUEUE=bg-removal

# API
DEBUG=true
MAX_FILE_SIZE=10485760

# Cloudflare R2 (ephemeral tmp bucket, 24h lifecycle)
# Never commit real credentials. Set these in Coolify / GitHub Secrets.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_TMP=agenteresolve-tmp
RESULT_URL_TTL=900

# Clerk (optional JWT verification; anonymous use stays allowed)
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUDIENCE=
